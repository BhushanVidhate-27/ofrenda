# Where Ollama is listening. Keep it on localhost for a fully offline archive.
OLLAMA_URL=http://127.0.0.1:11434

# Any open-weight model Ollama can run. gemma3:4b is a good default;
# gemma3:1b fits on a laptop with 8 GB of RAM.
OFRENDA_MODEL=gemma3:4b

# local  = ask the model (falls back to extractive when it is unreachable)
# extract  = never call a model; quote the archive's own words
OFRENDA_INFERENCE=local

# Where the archive lives. On Render, point this at the mounted disk.
OFRENDA_DATA_DIR=./data

# Optional: a name shown in the footer.
OFRENDA_OPERATOR=
